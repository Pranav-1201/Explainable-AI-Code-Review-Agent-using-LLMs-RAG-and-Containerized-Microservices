# ==========================================================
# Environment template — copy to .env and edit.
#   cp .env.example .env
# .env is gitignored; this file is not. Never put a real secret here.
# ==========================================================
#
# Every variable below is OPTIONAL: the app boots with all of them unset, in
# local-dev mode (open API, no LLM, no broker). The values shown are the actual
# built-in defaults, so an unedited copy changes nothing.
#
# That optionality is a LOCAL-DEV property and stops holding the moment the host
# is reachable from the internet. API_KEY in particular is not optional there:
# /scan runs `git clone` on request, so an unset key means anyone who finds the
# host can spend your disk and bandwidth. /health reports "auth": "disabled" so
# this is visible rather than assumed. See DEPLOYMENT.md.


# ----------------------------------------------------------
# HTTP trust boundary (backend/app/api_guard.py)
# ----------------------------------------------------------

# Shared secret required in the X-API-Key header on every non-public route.
# LEAVE UNSET FOR LOCAL DEV — unset means the API is open, and /health reports
# "auth": "disabled" so an unauthenticated deployment is visible at a glance.
# MUST be set for any deployment reachable from the internet: /scan runs
# `git clone` on request, which is expensive and abusable.
# The production overlay also passes it to the web container, which serves it
# to the browser at runtime through /config.js (D36) -- set it once here and
# both containers read it. Generate one with: openssl rand -hex 32
# API_KEY=

# Comma-separated CORS origins allowed to call the API from a browser.
# Default: http://localhost:8080,http://localhost:5173 (+ the 127.0.0.1 forms).
# "*" is stripped if supplied — a wildcard origin is never used.
# ALLOWED_ORIGINS=https://your-frontend.vercel.app

# Comma-separated hostnames that may be cloned. Setting this REPLACES the
# defaults (github.com, gitlab.com, bitbucket.org) rather than adding to them.
# ALLOWED_GIT_HOSTS=github.com,gitlab.com,bitbucket.org

# Requests per minute, per client, per route. Default 60.
# RATE_LIMIT_PER_MINUTE=60

# Where the rate-limit window is kept (S10).
# UNSET  -> the window is in this process's memory. Exact for a single API
#           container; with N replicas the effective limit becomes N x
#           RATE_LIMIT_PER_MINUTE, because each replica counts only its own
#           traffic.
# SET    -> the window lives in Redis and every replica spends from one budget.
#           Use a database of its own: 0 and 1 below belong to Celery.
# A Redis outage degrades back to the in-process window rather than failing
# open or closed, logs one warning, and stops retrying for 30s. GET /health
# reports which store is actually live. See DEPLOYMENT.md and DECISIONS.md D34.
# REDIS_URL=redis://redis:6379/2


# ----------------------------------------------------------
# Job queue (backend/app/services/celery_app.py)
# ----------------------------------------------------------

# UNSET = eager mode: scans run synchronously in the API process. That is the
# supported path for local dev and the test suite.
# SET = real dispatch to a Celery worker. Read at IMPORT time, so a change here
# needs a process restart, not just a new request.
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/1

# Where the scan-state SQLite DB lives. In docker-compose this must point at
# the volume SHARED by the api and worker containers, or the API will read an
# empty store and every scan will look stuck. Default: scan_states.db (cwd).
# SCAN_DB_PATH=/data/scan_states.db


# ----------------------------------------------------------
# LLM / model layer (all gated OFF by default — the analysis engine is
# deterministic and fully functional without any of these)
# ----------------------------------------------------------

# ENABLE_ANTHROPIC=false
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# CodeBERT-based scoring. Off by default; enabling it pulls model weights.
# ENABLE_CODEBERT=false

# Only needed to download gated Hugging Face models.
# HUGGINGFACE_TOKEN=

# Raises the GitHub API rate limit when fetching repository metadata.
# GITHUB_TOKEN=


# ----------------------------------------------------------
# Analysis tuning (backend/app/services/repo_analyzer.py)
# ----------------------------------------------------------

# auto | on | off. "auto" parallelises only above the file threshold below,
# because process startup costs more than it saves on a small repo.
# ANALYSIS_PARALLEL=auto

# File count at or above which "auto" switches parallelism on.
# ANALYSIS_PARALLEL_THRESHOLD=8

# 0 = derive from CPU count.
# ANALYSIS_MAX_WORKERS=0


# ----------------------------------------------------------
# Frontend (frontend/.env — Vite inlines these at BUILD time, so changing
# them requires a rebuild, not a restart)
# ----------------------------------------------------------

# Backend origin the browser calls. Default: http://localhost:8000
# VITE_API_BASE=https://api.your-domain.com

# LOCAL DEVELOPMENT ONLY. A deployed web container serves the key at runtime
# from API_KEY (/config.js, D36) and published images are built without this.
# Here it must match your local backend's API_KEY. WARNING: anything a browser
# receives is readable by anyone who loads the page — this raises the cost of
# drive-by abuse, it is not a per-user secret.
# VITE_API_KEY=


# ----------------------------------------------------------
# Disk ceilings (backend/app/disk_guard.py)
# ----------------------------------------------------------

# Combined ceiling in MB across the clone cache and the incremental prior
# store. When exceeded, least-recently-scanned repositories are evicted
# (clone and prior together) at the start of the next scan.
# MAX_CACHE_MB=5120

# Ceiling in MB on a single cloned repository. A clone growing past this is
# killed mid-flight and the partial tree deleted; the scan fails with a clear
# error. The 300s clone timeout is not a size limit — a fast link moves many
# gigabytes well inside it.
# MAX_REPO_MB=1024


# ----------------------------------------------------------
# Logging (backend/app/observability.py)
# ----------------------------------------------------------

# DEBUG | INFO | WARNING | ERROR. Applies to the root logger, so uvicorn and
# celery records are covered too.
# LOG_LEVEL=INFO

# text | json. Defaults to text so local console output stays readable; the
# Dockerfile sets json, so containers are structured without extra config.
# LOG_FORMAT=text


# ----------------------------------------------------------
# Error reporting (backend/app/observability.py)
# ----------------------------------------------------------

# Leave unset and Sentry is entirely disabled — no data leaves the machine.
# Set it to turn error reporting on; nothing else is required.
# SENTRY_DSN=

# Tag applied to reported events.
# SENTRY_ENVIRONMENT=development

# Performance tracing sample rate. 0.0 = tracing off.
# SENTRY_TRACES_SAMPLE_RATE=0.0

# ----------------------------------------------------------
# Production deployment (Phase F) — see DEPLOYMENT.md
# Only read when the production overlay is in use:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
# ----------------------------------------------------------

# The public address Caddy serves. UNSET means ":80" — plain HTTP, which is
# right for a laptop and wrong for a server. Set it to a hostname whose DNS
# already points at this host and Caddy obtains a certificate automatically on
# first boot. Ports 80 AND 443 must both be open: the HTTP-01 challenge uses
# 80 even though only 443 serves traffic afterwards.
# SITE_ADDRESS=scan.example.com

# Which published image to run. This is the rollback control: set it to a
# commit sha that GHCR already holds and bring the stack up again. The API and
# web images share the tag, so both move together.
# IMAGE_TAG=latest

# Override only if you publish to a different registry or fork the repo.
# IMAGE_REPO=ghcr.io/pranav-1201/ai-code-review-agent
# WEB_IMAGE_REPO=ghcr.io/pranav-1201/ai-code-review-agent-web

# ----------------------------------------------------------
# BUILD-TIME variables for the web image (Vite inlines these)
# ----------------------------------------------------------
# These are NOT read by a running container. Vite substitutes them into the
# JavaScript when the image is BUILT, so changing one means rebuilding the web
# image, not restarting it. Pass them with --build-arg, or set SITE_URL as a
# repository variable so release.yml bakes it into the published image.

# The public origin, scheme included, no trailing slash. Empty until a domain
# exists — and empty is a real setting, not a placeholder: canonical links,
# og:url, sitemap.xml and the robots.txt Sitemap line all omit THEMSELVES when
# it is empty, because a sitemap full of wrong URLs is worse than no sitemap.
# A crawler acts on what it is given.
# VITE_SITE_URL=https://scan.example.com

# Google Search Console verification token, rendered as a meta tag. A DNS TXT
# record is better once you own the domain, because it survives a rebuild.
# VITE_SEARCH_CONSOLE_TOKEN=

# Snapshot policy for the scan store. BACKUP_HOST_DIR is a HOST path,
# deliberately: a backup living only inside Docker dies with the Docker state
# you would be recovering from. (The path INSIDE the container is fixed at
# /backups and is not configurable — they are two different paths, and sharing
# one name is how you set the host directory and silently move the other one.)
#
# These snapshots are NOT covered by the Phase E disk ceilings, which bound the
# analysis caches only. BACKUP_KEEP is what bounds this directory.
# BACKUP_HOST_DIR=/var/lib/acra-backups
# BACKUP_INTERVAL_SECONDS=86400
# BACKUP_KEEP=7
